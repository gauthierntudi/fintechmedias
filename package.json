{
  "name": "entrevue",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @entrevue/api --filter @entrevue/web dev",
    "dev:up": "pnpm docker:dev && pnpm dev",
    "dev:api": "pnpm --filter @entrevue/api dev",
    "dev:web": "pnpm --filter @entrevue/web dev",
    "build": "pnpm -r --filter @entrevue/api --filter @entrevue/web build",
    "lint": "pnpm -r --filter @entrevue/api --filter @entrevue/web lint",
    "db:generate": "pnpm --filter @entrevue/api prisma:generate",
    "db:migrate": "pnpm --filter @entrevue/api prisma:migrate",
    "db:studio": "pnpm --filter @entrevue/api prisma:studio",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "cf:install": "pnpm --dir deploy/cloudflare install",
    "cf:deploy": "pnpm --dir deploy/cloudflare run cf:deploy:all",
    "cf:d1:migrate": "pnpm --dir deploy/cloudflare d1:migrate:remote"
  },
  "engines": {
    "node": ">=20"
  }
}
