# Apps — L'Entrevue
# Copier vers .env à la racine (jamais committer le vrai .env)
# Domaine : lentrevuemag.com

NODE_ENV=production
# default.conf après Let’s Encrypt ; default.http.conf au premier boot
NGINX_CONF=default.conf
APP_URL=https://lentrevuemag.com
# Même valeur pour le front (metadata / Open Graph) — optionnel si APP_URL est injecté au runtime
NEXT_PUBLIC_APP_URL=https://lentrevuemag.com
API_URL=https://api.lentrevuemag.com
NEXT_PUBLIC_API_URL=https://api.lentrevuemag.com
# SSR Docker (optionnel — déjà défaut dans docker-compose.yml)
API_INTERNAL_URL=http://api:3001

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_DOMAIN=.lentrevuemag.com

# PostgreSQL (VPS Docker) — ou managed
DATABASE_URL=postgresql://entrevue:entrevue@postgres:5432/entrevue
POSTGRES_USER=entrevue
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=entrevue

# Redis (VPS Docker) — ou managed
REDIS_URL=redis://redis:6379
# Worker PDF→WebP : slots parallèles (garder bas sur VPS 8 Go — OOM sinon)
# urgent = lecture/aperçu, bulk = backfill/upload
MAGAZINE_PAGES_URGENT_CONCURRENCY=1
MAGAZINE_PAGES_CONCURRENCY=1
# Rasterizer : rust (PDFium, défaut en Docker) | node (pdf.js fallback)
MAGAZINE_PAGES_RASTERIZER=rust
# MAGAZINE_PAGES_RASTER_BIN=/usr/local/bin/magazine-pages-raster
# PDFIUM_DIR=/usr/local/lib
# Reaper jobs orphelins (PENDING / PROCESSING stale), ms — défaut 5 min
MAGAZINE_PAGES_RECOVER_INTERVAL_MS=300000
# Newsletter : 70 e-mails / jour (nouvel article → inscrits)
NEWSLETTER_DAILY_LIMIT=70
# 0 sur l’API Docker (le worker envoie). En local sans worker, omettre.
NEWSLETTER_SEND_IN_API=0
# Vidéo article (FFmpeg → HLS sur R2)
ARTICLE_VIDEO_CONCURRENCY=1
# ARTICLE_VIDEO_RECOVER_INTERVAL_MS=300000
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Plafond V8 (Mo) — doit rester sous mem_limit Docker du worker
NODE_OPTIONS=--max-old-space-size=2048

# Monitoring admin (superadmins) — alertes email Resend
MONITORING_ALERTS=true
MONITORING_ALERT_INTERVAL_MS=300000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=entrevue
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.lentrevuemag.com
# true seulement si le custom domain R2 (cdn…) a bien un DNS
AVATAR_USE_CDN=false

# FlexPaie / FlexPay (mobile)
FLEXPAIE_MERCHANT=
FLEXPAIE_TOKEN=
FLEXPAIE_MOBILE_API_URL=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAIE_CARD_API_URL=https://cardpayment.flexpay.cd/v1.1/pay
FLEXPAIE_CHECK_API_URL=https://backend.flexpay.cd/api/rest/v1/check
FLEXPAIE_CALLBACK_URL=https://api.lentrevuemag.com/api/payments/flexpaie/callback

# Email — Resend
RESEND_API_KEY=re_...
MAIL_FROM="Fintech Médias <noreply@fintechmedias.com>"

# Admin (seed)
ADMIN_EMAIL=admin@lentrevuemag.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Administrateur

# Google Sign-In (GSI) — Client ID OAuth Web (id_token aud)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Clients OAuth iOS / Android (optionnel si serverClientId = client web)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Liste supplémentaire, séparée par des virgules
GOOGLE_CLIENT_IDS=

# Cloudflare Turnstile
# CAPTCHA=true active le widget (front) + la vérif API. false = désactivé.
CAPTCHA=false
NEXT_PUBLIC_CAPTCHA=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
