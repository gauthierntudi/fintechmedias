# Variables / secrets pour le déploiement Cloudflare Fintech Médias
# Ne pas committer les vraies valeurs.

APP_URL=https://fintechmedias.com
NEXT_PUBLIC_APP_URL=https://fintechmedias.com
API_URL=https://api.fintechmedias.com
NEXT_PUBLIC_API_URL=https://api.fintechmedias.com
# Depuis le container Nest → Worker Data (service binding côté gateway ;
# en direct : URL workers.dev du data-worker ou binding interne)
D1_PROXY_URL=https://fintech-data.<ACCOUNT>.workers.dev
DATABASE_DRIVER=d1
DATA_WORKER_SECRET=change-me-data-secret

# Redis managé (BullMQ) — TLS
REDIS_URL=rediss://default:PASSWORD@HOST:6379

COOKIE_DOMAIN=.fintechmedias.com
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fintechmedias
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.fintechmedias.com
AVATAR_USE_CDN=true

FLEXPAIE_MERCHANT=
FLEXPAIE_TOKEN=
FLEXPAIE_CALLBACK_URL=https://api.fintechmedias.com/api/payments/flexpaie/callback

RESEND_API_KEY=
MAIL_FROM="Fintech Médias <noreply@fintechmedias.com>"

# Build Next (args Docker)
NEXT_PUBLIC_APP_URL=https://fintechmedias.com
NEXT_PUBLIC_API_URL=https://api.fintechmedias.com
